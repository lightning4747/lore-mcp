# ==========================================
# Lore MCP - Render Environment Configuration
# ==========================================
# Populate these environment variables in your Render Web Service dashboard
# (Settings -> Environment Variables) or via Render Blueprint (render.yaml).

# 1. Qdrant Cloud (Managed Vector Database)
# Cluster URL provided by Qdrant Cloud console (include :6333 port if specified)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key

# 2. Upstash Redis (Managed Serverless Cache & Budgets)
# Standard redis connection string with rediss:// for secure TLS connection
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# 3. Dynamic External Web Search Fallback (Tavily)
TAVILY_API_KEY=tvly-your_tavily_api_key

# 4. MCP Server Access Control
# Use "open" for authless access (recommended for Claude custom connectors)
# Or "path_token" to serve at /<token>/mcp for obscure path security
MCP_ACCESS_MODE=open
MCP_PATH_TOKEN=

# 5. Application Logging & Versioning
LOG_LEVEL=info
